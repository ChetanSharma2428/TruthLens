# ==============================================================================
# TruthLens Backend Environment Template (.env.example)
# ==============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Primary Database: MongoDB Atlas
# Connection string to your MongoDB Atlas cluster or local database instance
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/truthlens?retryWrites=true&w=majority

# Reviewer Security & Session Secret
# Access code required to enter the authenticated /reviewer fact-checking workspace
REVIEWER_ACCESS_CODE=TRUTHLENS-DEMO-2026
SESSION_SECRET=your_long_random_session_secret_key_minimum_32_characters

# Google Gemini API (Multimodal OCR & Advisory Research Assistance)
# Obtain from Google AI Studio: https://aistudio.google.com/
# If omitted, TruthLens operates 100% smoothly using built-in heuristic fallbacks.
GEMINI_API_KEY=

# Cloudinary (Screenshot Evidence Storage & CDN)
# Obtain from Cloudinary Dashboard: https://cloudinary.com/console
# If omitted, screenshot uploads will operate with memory/placeholder fallbacks.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (Caching & Collaborative Newsroom Collision Locks)
# Connection URI (e.g. Upstash, Redis Cloud, or redis://127.0.0.1:6379)
# If omitted, TruthLens automatically uses a resilient in-memory Map fallback.
REDIS_URL=
